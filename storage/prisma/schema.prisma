generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id              String              @id @default(uuid()) @db.Uuid
  email           String
  emailNormalized String              @unique
  name            String
  passwordHash    String
  status          String              @default("ACTIVE")
  shareCodeHash   String              @unique
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  books           Book[]
  reviews         CharacterReview[]
  sessions        ExtractionSession[]
  refreshSessions RefreshSession[]
  aiUsageRecords  AiUsageRecord[]
}

model Book {
  id                String              @id @default(uuid()) @db.Uuid
  title             String
  filePath          String
  fileSize          Int
  mimeType          String              @default("text/plain")
  status            String              @default("UPLOADED")
  userId            String              @db.Uuid
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceObjectKey   String?
  currentSnapshotId String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  characters        Character[]
  locations         Location[]
  items             Item[]
  worldviewSettings WorldviewSetting[]
  sessions         ExtractionSession[]    @relation("BookSessions")
  tasks             Task[]
  noiseOverrides    NoiseOverride[]
  entityImages      EntityImage[]
  visualSpecs       VisualSpec[]
  snapshots         AssetSnapshot[]     @relation("BookSnapshots")
  bookShares        BookShare[]         @relation("BookShares")
  artifacts         BookArtifact[]      @relation("BookArtifacts")
  sourceBookId      String?             @db.Uuid
  sourceShareId     String?             @db.Uuid

  /// 书籍来源：UPLOAD=普通上传 | SEED=示例书 | SHARED_COPY=分享副本
  sourceType                 String             @default("UPLOAD")
  sourcePackageId            String?
  sourcePackageVersion       String?
  /// 原文或噪声覆盖变化时 +1
  sourceRevision             Int                @default(0)
  /// 等于 sourceRevision 才能启动提取；null 表示从未确认
  preprocessConfirmedRevision Int?
  /// 只指向最近一次成功发布的结果
  currentExtractionSessionId String?            @db.Uuid
  onboardingFeatured         Boolean            @default(false)

  currentExtractionSession ExtractionSession?          @relation("CurrentExtractionSession", fields: [currentExtractionSessionId], references: [id], onDelete: SetNull)
  entityReviews            EntityReview[]
  aiUsageRecords           AiUsageRecord[]

  @@index([userId])
}

model Character {
  id                 String            @id @default(uuid()) @db.Uuid
  bookId             String            @db.Uuid
  book               Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name               String
  aliases            Json              @default("[]")
  description        String?
  confidence         Float             @default(0.5)
  status             String            @default("PENDING")
  chapterRef         String?
  firstChapter       Int?
  lastChapter        Int?
  chapterAppearances Json              @default("[]")
  mentionCount       Int               @default(0)
  dialogueCount      Int               @default(0)
  coCharacters       Json              @default("[]")
  outfits            Json              @default("[]")
  ageStages          Json              @default("[]")
  primaryAgeStage    String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  reviews            CharacterReview[]

  /// 实体稳定键：跨提取运行保持不变，用于成果对齐与人工保护
  stableKey                    String    @default(uuid())
  /// 审核来源：AI | IMPORTED | USER
  reviewSource                 String    @default("AI")
  /// 用户编辑过的字段名，重新提取不得覆盖
  lockedFields                 Json      @default("[]")
  version                      Int       @default(1)
  missingFromLatestRun         Boolean   @default(false)
  archivedAt                   DateTime? @db.Timestamptz(3)
  lastSeenExtractionSessionId  String?   @db.Uuid

  @@index([bookId])
  @@index([bookId, status])
  @@index([bookId, stableKey])
}

model Location {
  id                 String   @id @default(uuid()) @db.Uuid
  bookId             String   @db.Uuid
  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name               String
  aliases            Json     @default("[]")
  description        String?
  confidence         Float    @default(0.5)
  status             String   @default("PENDING")
  chapterRef         String?
  importanceScore    Float    @default(0)
  tier               String   @default("candidate")
  storyScore         Int      @default(0)
  productionScore    Float    @default(0)
  pillarCausal       Int      @default(0)
  pillarUniqueness   Int      @default(0)
  pillarTransition   Int      @default(0)
  mentionCount       Int      @default(0)
  firstChapter       Int?
  lastChapter        Int?
  chapterAppearances Json     @default("[]")
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  stableKey                    String    @default(uuid())
  reviewSource                 String    @default("AI")
  lockedFields                 Json      @default("[]")
  version                      Int       @default(1)
  missingFromLatestRun         Boolean   @default(false)
  archivedAt                   DateTime? @db.Timestamptz(3)
  lastSeenExtractionSessionId  String?   @db.Uuid

  @@index([bookId])
  @@index([tier])
  @@index([bookId, status])
  @@index([bookId, stableKey])
}

model Item {
  id                 String   @id @default(uuid()) @db.Uuid
  bookId             String   @db.Uuid
  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name               String
  aliases            Json     @default("[]")
  category           String   @default("other") // 大类：weapon|skill|food|pill|treasure|other
  description        String?
  confidence         Float    @default(0.5)
  status             String   @default("PENDING")
  chapterRef         String?
  importanceScore    Float    @default(0)
  tier               String   @default("candidate")
  storyScore         Int      @default(0)
  productionScore    Float    @default(0)
  pillarCausal       Int      @default(0)
  pillarUniqueness   Int      @default(0)
  pillarTransition   Int      @default(0)
  mentionCount       Int      @default(0)
  firstChapter       Int?
  lastChapter        Int?
  chapterAppearances Json     @default("[]")
  owners             Json     @default("[]")
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  stableKey                    String    @default(uuid())
  reviewSource                 String    @default("AI")
  lockedFields                 Json      @default("[]")
  version                      Int       @default(1)
  missingFromLatestRun         Boolean   @default(false)
  archivedAt                   DateTime? @db.Timestamptz(3)
  lastSeenExtractionSessionId  String?   @db.Uuid

  @@index([bookId])
  @@index([tier])
  @@index([bookId, status])
  @@index([bookId, category])
  @@index([bookId, stableKey])
}

/// 世界观与体系设定实体（灵气/斗气等能量体系、境界等级、组织势力、规则法则）。
model WorldviewSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  bookId             String   @db.Uuid
  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name               String
  aliases            Json     @default("[]")
  category           String   @default("worldview") // worldview|power-system|realm|faction|rule
  description        String?
  confidence         Float    @default(0.5)
  status             String   @default("PENDING")
  chapterRef         String?
  importanceScore    Float    @default(0)
  tier               String   @default("candidate")
  mentionCount       Int      @default(0)
  firstChapter       Int?
  lastChapter        Int?
  chapterAppearances Json     @default("[]")
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  stableKey                    String    @default(uuid())
  reviewSource                 String    @default("AI")
  lockedFields                 Json      @default("[]")
  version                      Int       @default(1)
  missingFromLatestRun         Boolean   @default(false)
  archivedAt                   DateTime? @db.Timestamptz(3)
  lastSeenExtractionSessionId  String?   @db.Uuid

  @@index([bookId])
  @@index([bookId, status])
  @@index([category])
  @@index([bookId, stableKey])
}

model CharacterReview {
  id            String    @id @default(uuid()) @db.Uuid
  characterId   String    @db.Uuid
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  action        String
  previousValue String?
  newValue      String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
}

/// 提取运行批次。一本书同时最多一个活动运行，由迁移中的部分唯一索引
/// ExtractionSession_book_active_unique（status IN 活动态时 bookId 唯一）约束。
model ExtractionSession {
  id          String    @id @default(uuid()) @db.Uuid
  bookId      String    @db.Uuid
  book        Book      @relation("BookSessions", fields: [bookId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// QUEUED | RUNNING | PAUSING | PAUSED | CANCELLING | CANCELLED | COMPLETED | FAILED
  status      String    @default("RUNNING")
  /// LIVE=真实运行 | IMPORTED=导入 | LEGACY_IMPORTED=旧数据补建
  kind        String    @default("LIVE")
  /// 创建该运行时的书籍 sourceRevision
  sourceRevision Int    @default(0)
  startedAt   DateTime? @db.Timestamptz(3)
  pauseRequestedAt   DateTime? @db.Timestamptz(3)
  cancelRequestedAt  DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  failureReason String?
  estimatedInputChars BigInt?
  estimatedCalls Int?
  maxCalls    Int?
  maxTokens   Int?
  manifest    Json?
  usageSummary Json?
  /// 结果发布为当前稳定版本的时间
  promotedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  currentForBooks Book[] @relation("CurrentExtractionSession")
  tasks           Task[]
}

model Task {
  id           String    @id @default(uuid()) @db.Uuid
  bookId       String    @db.Uuid
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  agentType    String
  payload      Json      @default("{}")
  /// pending | running | completed | failed | cancelled
  status       String    @default("pending")
  result       Json?
  error        String?
  retryCount   Int       @default(0)
  deadLettered Boolean   @default(false)
  failedAt     DateTime? @db.Timestamptz(3)
  extractionSessionId String? @db.Uuid
  startedAt    DateTime? @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  extractionSession ExtractionSession? @relation(fields: [extractionSessionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([agentType])
  @@index([bookId])
  @@index([bookId, status])
}

/// 文本清洗的人工覆盖：标记某行被“找回”（不删除）。lineNum 为规范化后文本 1-based 行号。
model NoiseOverride {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @db.Uuid
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lineNum   Int
  action    String   @default("keep")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([bookId, lineNum])
  @@index([bookId])
}

/// 实体图片元数据；文件名只使用 UUID，entityName 不进入文件路径。
model EntityImage {
  id          String   @id @default(uuid()) @db.Uuid
  bookId      String   @db.Uuid
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  entityType  String
  entityName  String
  filePath    String
  objectKey   String?
  mime        String
  ext         String
  bytes       Int
  aspectRatio String?
  source      String   @default("generated")
  stage       String?
  isPrimary     Boolean  @default(false)
  sortOrder     Int      @default(0)
  visualSpecId  String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([bookId, entityType, entityName])
  @@index([bookId])
  @@index([visualSpecId])
}

/// 可被下游钉死引用的视觉规格：prompt + 变体键 + 版本 + 主图。
/// 稳定键是 bookId+entityType+entityName+variantKey，重提只 SUPERSEDE 不删历史。
model VisualSpec {
  id             String   @id @default(uuid()) @db.Uuid
  bookId         String   @db.Uuid
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  entityType     String
  entityName     String
  variantKey     String
  version        Int
  status         String   @default("ACTIVE")
  prompt         String
  promptSource   String
  quality        String?
  styleTags      Json     @default("[]")
  model          String?
  primaryImageId String?  @db.Uuid
  sourceChapters String?
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([bookId, entityType, entityName, variantKey, version])
  @@index([bookId, entityType, entityName, status])
  @@index([bookId, status])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  rotatedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
}

model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  kind           String
  uniqueKey      String    @unique
  status         String    @default("pending")
  payload        Json
  result         Json?
  error          String?
  attempts       Int       @default(0)
  leaseOwner     String?
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  nextRunAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, nextRunAt])
  @@index([leaseExpiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorType  String
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
}

/// 不可变对象：内容寻址（sha256+bytes 唯一），objectKey 私有且不可覆盖。跨书籍去重。
model AssetObject {
  id        String   @id @default(uuid()) @db.Uuid
  sha256    String
  bytes     BigInt
  mime      String
  objectKey String   @unique
  etag      String?
  versionId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  snapshots SnapshotObject[]
  publicAssetImages PublicAssetImage[]

  @@unique([sha256, bytes])
  @@index([sha256])
}

/// 资产快照：版本化、不可变（ready 后不可改）。新表统一用 ownerId 语义（ADR 0001）。
model AssetSnapshot {
  id               String    @id @default(uuid()) @db.Uuid
  bookId           String    @db.Uuid
  book             Book      @relation("BookSnapshots", fields: [bookId], references: [id], onDelete: Cascade)
  ownerId          String    @db.Uuid
  version          Int
  contentRevision  String
  status           String    @default("building")
  manifestObjectId String?   @db.Uuid
  archiveObjectId  String?   @db.Uuid
  failureReason    String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  readyAt          DateTime? @db.Timestamptz(3)
  objects          SnapshotObject[]
  shares           BookShare[]         @relation("SnapshotShares")

  @@unique([bookId, version])
  @@unique([bookId, contentRevision], map: "AssetSnapshot_book_content_revision")
  @@index([bookId, status])
  @@index([ownerId])
}

/// 快照与对象的引用关系；logicalPath 为 ZIP 内逻辑路径，唯一 per 快照。
/// state 限定 present/empty/not-generated；对象是否可删除由引用关系事务计算。
model SnapshotObject {
  id          String @id @default(uuid()) @db.Uuid
  snapshotId  String @db.Uuid
  snapshot    AssetSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  objectId    String @db.Uuid
  object      AssetObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  logicalPath String
  category    String
  state       String
  reason      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([snapshotId, logicalPath])
  @@index([objectId])
  @@index([snapshotId])
}

/// 指定账号分享：active→copying→copied 或 active→revoked（条件更新，先成功者决定）。
model BookShare {
  id            String    @id @default(uuid()) @db.Uuid
  bookId        String    @db.Uuid
  book          Book      @relation("BookShares", fields: [bookId], references: [id], onDelete: Cascade)
  snapshotId    String    @db.Uuid
  snapshot      AssetSnapshot @relation("SnapshotShares", fields: [snapshotId], references: [id], onDelete: Restrict)
  senderId      String    @db.Uuid
  recipientId   String    @db.Uuid
  status        String    @default("active") // active|copying|copied|revoked
  failureReason String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  claimedAt     DateTime? @db.Timestamptz(3)
  copiedAt      DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  @@index([recipientId, status])
  @@index([bookId, status])
  @@index([senderId])
}

/// 书籍文件型产物登记（提取/故事/导演/run-summary 等）：(bookId, logicalPath) 唯一，
/// objectKey 指向对象存储；多设备经此表定位产物，不再扫描本机 output/。
model BookArtifact {
  id          String   @id @default(uuid()) @db.Uuid
  bookId      String   @db.Uuid
  book        Book     @relation("BookArtifacts", fields: [bookId], references: [id], onDelete: Cascade)
  logicalPath String
  category    String
  objectKey   String
  sha256      String
  bytes       BigInt
  mime        String
  /// 产物基于的书籍 sourceRevision；与当前不一致时显示"基于旧版原文生成"
  sourceRevision Int?
  extractionSessionId String? @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([bookId, logicalPath])
  @@index([bookId])
  @@index([bookId, sourceRevision])
}

/// 公共素材：实体卡的不可变快照。payload 自包含，不依赖源书/源实体存活。
/// publisherId/takerId/targetBookId 均为裸列（无 FK），避免删用户/删书级联影响公共池。
model PublicAsset {
  id           String   @id @default(uuid()) @db.Uuid
  publisherId  String   @db.Uuid
  kind         String   // character | location | item
  name         String   // 实体名（列表页主标题，冗余自 payload 便于检索）
  summary      String?  // 一句话介绍（列表页副标题）
  tags         Json     @default("[]") // string[]，发布者自填
  payload      Json     // 实体完整快照：字段集 + visualDetails + promptVariants
  status       String   @default("published") // published | unlisted（下架）| removed（管理员）
  takenCount   Int      @default(0)           // 冗余计数，排序用，由 PublicAssetTake 事务维护
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  images       PublicAssetImage[]
  takes        PublicAssetTake[]

  @@index([status, kind])
  @@index([publisherId])
  @@index([status, takenCount])
}

/// 公共素材的图片引用：字节不复制，指向 AssetObject（内容寻址）。
/// objectKey 冗余存储便于直接签 URL；AssetObject 行保证对象不被引用计数回收。
model PublicAssetImage {
  id             String @id @default(uuid()) @db.Uuid
  publicAssetId  String @db.Uuid
  publicAsset    PublicAsset @relation(fields: [publicAssetId], references: [id], onDelete: Cascade)
  assetObjectId  String @db.Uuid
  assetObject    AssetObject @relation(fields: [assetObjectId], references: [id], onDelete: Restrict)
  objectKey      String
  mime           String
  bytes          Int
  aspectRatio    String?
  stage          String?  // 年龄阶段（与 EntityImage.stage 对齐）
  isPrimary      Boolean  @default(false)
  sortOrder      Int      @default(0)

  @@index([publicAssetId])
  @@index([assetObjectId])
}

/// 拿取记录：计数、防重复拿取提示、后续"我的拿取"列表。
model PublicAssetTake {
  id            String   @id @default(uuid()) @db.Uuid
  publicAssetId String   @db.Uuid
  publicAsset   PublicAsset @relation(fields: [publicAssetId], references: [id], onDelete: Cascade)
  takerId       String   @db.Uuid
  targetBookId  String   @db.Uuid   // 拿取到哪本书
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([takerId])
  @@index([publicAssetId])
  @@index([takerId, targetBookId, publicAssetId])
}

/// 统一审核历史：四类实体（character | location | item | worldview）的创建/编辑/通过/拒绝/合并等动作记录。
/// 旧 CharacterReview 保留一个兼容周期并双写。
model EntityReview {
  id           String   @id @default(uuid()) @db.Uuid
  bookId       String   @db.Uuid
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// character | location | item | worldview
  entityType   String
  entityId     String   @db.Uuid
  entityName   String
  actorId      String?  @db.Uuid
  /// USER | SYSTEM | IMPORT
  actorType    String
  /// CREATE | EDIT | APPROVE | REJECT | RESTORE_FIELD | AI_REFRESH | MERGE_SUGGESTED | MERGE_ACCEPTED | MERGE_REJECTED | ARCHIVE
  action       String
  beforeValue  Json?
  afterValue   Json?
  changedFields Json    @default("[]")
  reason       String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([bookId, entityType, entityId, createdAt])
  @@index([bookId, createdAt])
}

/// 模型调用账本：按用户/书籍/运行记录每次模型调用的用量与状态，不做价格配置。
model AiUsageRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookId              String?  @db.Uuid
  book                Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  extractionSessionId String?  @db.Uuid
  /// TEXT_EXTRACTION | IMAGE_GENERATION | MERGE_JUDGEMENT | ENTITY_ENRICHMENT | TAG_SUGGESTION
  operation           String
  provider            String?
  model               String?
  promptTokens        Int?
  completionTokens    Int?
  totalTokens         Int?
  unitCount           Int      @default(1)
  durationMs          Int      @default(0)
  /// PROVIDER | ESTIMATED | UNAVAILABLE
  usageSource         String   @default("UNAVAILABLE")
  /// SUCCEEDED | FAILED | CANCELLED
  status              String   @default("SUCCEEDED")
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([bookId, createdAt])
  @@index([extractionSessionId])
}
