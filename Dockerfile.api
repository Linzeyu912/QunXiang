# ===== API 单阶段构建 =====
# 各包 main 指向 src/*.ts，用 tsx 运行（与开发模式一致）
# 不做多阶段 prune（tsx 在 devDependencies，去掉会运行不了）

FROM node:20-bookworm-slim
WORKDIR /app
# 安装 OpenSSL（Prisma 运行时需要）
RUN apt-get update -qq && apt-get install -y -qq openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# 拷 workspace 配置和所有包的 package.json（利用 Docker 层缓存）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY core/package.json core/package.json
COPY schemas/package.json schemas/package.json
COPY storage/package.json storage/package.json
COPY import/package.json import/package.json
COPY extractors/package.json extractors/package.json
COPY validators/package.json validators/package.json
COPY entity-resolution/package.json entity-resolution/package.json
COPY entity-prescan/package.json entity-prescan/package.json
COPY scheduler/package.json scheduler/package.json
COPY agent/package.json agent/package.json
COPY story-arcs/package.json story-arcs/package.json
COPY llm/package.json llm/package.json
COPY api/package.json api/package.json
COPY exporters/package.json exporters/package.json
COPY prompts/package.json prompts/package.json
COPY preprocess/package.json preprocess/package.json

# 安装全部依赖
RUN pnpm install --frozen-lockfile

# 拷贝全部源码
COPY core/ core/
COPY schemas/ schemas/
COPY storage/ storage/
COPY import/ import/
COPY extractors/ extractors/
COPY validators/ validators/
COPY entity-resolution/ entity-resolution/
COPY entity-prescan/ entity-prescan/
COPY scheduler/ scheduler/
COPY agent/ agent/
COPY story-arcs/ story-arcs/
COPY llm/ llm/
COPY api/ api/
COPY exporters/ exporters/
COPY prompts/ prompts/
COPY preprocess/ preprocess/
COPY seed-library/ seed-library/

# 生成 Prisma client
RUN pnpm --filter @novel-agent/storage exec prisma generate --schema=./prisma/schema.prisma

# 对象存储目录
RUN mkdir -p /app/storage/objects

EXPOSE 3001
CMD ["npx", "tsx", "api/src/index.ts"]
