# Dependencies
node_modules/
.pnpm/

# Build outputs
dist/
build/
*.tsbuildinfo

# 不要把各包 src 下的 tsc 编译产物提交进来
# （各包 main 指向 src 源码、走 tsx 即时编译，无需 .js/.d.ts/.map）
**/src/**/*.js
**/src/**/*.d.ts
**/src/**/*.js.map
**/src/**/*.d.ts.map

# Logs
*.log
pnpm-debug.log*
logs/

# Database
*.db
*.db-journal
*.db-shm
*.db-wal
prisma/dev.db
prisma/dev.db-journal
prisma/prisma/
*.db.bak*

# Environment files
.env
.env.local
.env.*.local
.env.docker
api.env
!.env.example

# Deployment secrets
.db-password

# Encrypted config (contains API keys)
.qunxiang-config.encrypted
.qunxiang-image-config.encrypted
# 兼容旧版本地配置，禁止误提交。
.novel-agent-config.encrypted
.novel-agent-image-config.encrypted

# Claude Code
.claude/
.codebuddy/
.omc/
.worktrees/

# Other AI/tool metadata (auto-generated, not project content)
.qoder/
.workbuddy/

# IDE
.idea/
.vscode/
.obsidian/

# OS
.DS_Store
Thumbs.db

# Test/Debug files
test_*.bat
test_*.mjs
startup_log*.txt
test_results.txt
test/

# Uploads and runtime data
storage/uploads/
storage/objects/
storage/pgdata/
storage/dispatcher.log

# Pipeline run output (contains verbatim excerpts of source novels — never commit)
output/

# Intermediate prescan output (backend-only, not user-facing)
.intermediate/


# IDE session files
.zcode/
