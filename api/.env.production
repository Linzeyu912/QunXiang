PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# JWT 密钥（部署脚本自动生成；或手动用 openssl rand -hex 32 生成）
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARS

# 数据库（Docker 内部网络；密码从 docker-compose 环境变量注入）
# DATABASE_URL 和 DIRECT_DATABASE_URL 在 docker-compose.prod.yml 的 environment 中动态生成
# 这里只需占位，compose 会覆盖
DATABASE_URL=postgresql://qunxiang:PLACEHOLDER@postgres:5432/qunxiang
DIRECT_DATABASE_URL=postgresql://qunxiang:PLACEHOLDER@postgres:5432/qunxiang

# CORS：部署脚本自动替换为服务器 IP
ALLOWED_ORIGINS=http://localhost

LOG_LEVEL=info

# 对象存储
OBJECT_STORAGE_PROVIDER=fs
OBJECT_STORAGE_SIGN_SECRET=REPLACE_WITH_RANDOM_64_CHARS
OBJECT_STORAGE_FS_ROOT=/app/storage/objects

# LLM 配置（国内服务）
LLM_PROVIDER=custom
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1/chat/completions
LLM_MODEL=MiniMax-M2.7-highspeed
LLM_TIMEOUT=600000

# 提取并发（服务器资源有限，适当降低）
EXTRACTOR_MAX_CONCURRENT_BATCHES=3
EXTRACTOR_BATCH_SIZE=10
VISUAL_DESCRIPTION_MAX_CONCURRENT=4

# 加密密钥（部署脚本生成后必须备份！丢失 = 所有加密的 LLM 配置报废）
KEY_VAULTS_SECRET=REPLACE_WITH_RANDOM_64_CHARS
