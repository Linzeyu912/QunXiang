# API 基础配置
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# 本地开发也必须配置；生产环境请分别替换为独立的强随机值
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_EXPIRES_IN=24h
KEY_VAULTS_SECRET=change-me-to-a-long-random-vault-secret

# 允许跨域访问的来源，多个地址用英文逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,https://staging.example.com

# Prisma 迁移和 API 使用的 PostgreSQL 直连地址。
DATABASE_URL=postgresql://qunxiang:change_me_in_production@localhost:5432/qunxiang
DIRECT_DATABASE_URL=postgresql://qunxiang:change_me_in_production@localhost:5432/qunxiang

# =============================================================================
# LLM 服务商配置
# 从下面的选项中选择一种：
# =============================================================================

# -----------------------------------------------------------------------------
# 选项 A：自定义 API（兼容 OpenAI 协议）
# 支持 OpenAI、DeepSeek、MiniMax 等任何兼容接口。
# 多个密钥用英文逗号分隔，可轮询使用以提高并发能力。
# -----------------------------------------------------------------------------
# LLM_PROVIDER=custom
# LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEYS=sk-key1,sk-key2,sk-key3

# --- 提取管道稳定性开关（强烈建议开启）---
# 组调用（实体提取批次/简介融合/提示词润色）一次返回全组 JSON：
# 实测实体密集的 10 章批次输出约 6K token，默认输出上限会截断导致批次失败。
# LLM_MAX_TOKENS=16384
# 强制 JSON 输出模式，降低长输出解析失败率
# LLM_JSON_MODE=1
# 推理模型（如 deepseek-v4-flash）必开：思考 token 与正文共享输出额度，
# 不关闭时长任务正文为空（Empty response），提取/融合/润色均为结构化任务无需思考
# LLM_DISABLE_THINKING=1
#
# --- 实体提取批次阈值（鲁棒性）---
# 单批章数/字符双上限（超长章节提前切批，防输出截断），单批超时与重试次数
# EXTRACTOR_BATCH_SIZE=10
# EXTRACTOR_MAX_BATCH_CHARS=30000
# EXTRACTOR_BATCH_TIMEOUT_MS=300000
# EXTRACTOR_MAX_RETRIES=4

# -----------------------------------------------------------------------------
# 选项 B：模拟数据（仅用于开发和测试）
# 返回内置的测试角色，不会请求外部模型。
# -----------------------------------------------------------------------------
# LLM_MOCK_ENABLED=true

# =============================================================================
# Image Generation Configuration (文生图 / text-to-image)
# OpenAI-compatible protocol (/v1/images/generations).
# Supported: reve, OpenAI DALL-E, SiliconFlow, 火山引擎 Seedream, etc.
# =============================================================================
# IMAGE_PROVIDER=custom
# IMAGE_API_KEY=sk-your-image-api-key
# IMAGE_BASE_URL=https://api.reve.com/v1/image/create
# IMAGE_MODEL=reve/create-image
# IMAGE_TIMEOUT=120000
# IMAGE_B64_INLINE=1
#
# # 图片尺寸（Seedream/OpenAI 风格，优先于 aspect_ratio）
# # Seedream: "2K" / "1024x1024" / "1024x768"
# # OpenAI: "1024x1024" / "1792x1024" / "1024x1792"
# IMAGE_SIZE=2K
#
# # 水印（Seedream 支持）
# IMAGE_WATERMARK=1
#
# # 代理配置（Reve 等海外服务在国内需要代理）
# # 不设置则自动检测本地 SOCKS5 端口（Clash 7891/7892、V2Ray 10808、Shadowsocks 1080 等）
# # 手动指定优先级高于自动检测
# IMAGE_PROXY=socks5://127.0.0.1:7891  # SOCKS5 代理
# IMAGE_PROXY=http://127.0.0.1:7890    # HTTP 代理
#
# # 默认宽高比（可按实体类型覆盖）
# IMAGE_DEFAULT_RATIO_CHARACTER=3:4
# IMAGE_DEFAULT_RATIO_ITEM=1:1
# IMAGE_DEFAULT_RATIO_LOCATION=16:9

# =============================================================================
# Object Storage（阶段二：原书/图片/快照/完整数据包）
# FS 实现（本地开发默认，免 Docker）；S3 兼容（MinIO 测试 / 正式 R2/AWS/OSS）
# =============================================================================
# 本地文件系统实现（默认）
OBJECT_STORAGE_PROVIDER=fs
# FS 签名密钥（内部下载端点 HMAC，必须配置；仅服务端持有，不外泄）
OBJECT_STORAGE_SIGN_SECRET=change-me-to-a-long-random-secret
# FS 对象根目录（默认 {项目根}/storage/objects）
# OBJECT_STORAGE_FS_ROOT=
# 内部下载端点路径（FsObjectStore 签名地址前缀）
# OBJECT_STORAGE_DOWNLOAD_PATH=/objects/dl

# S3 兼容实现（正式 / MinIO 测试）。把 OBJECT_STORAGE_PROVIDER 改为 s3 启用。
# OBJECT_STORAGE_PROVIDER=s3
# OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_BUCKET=qunxiang
# OBJECT_STORAGE_ACCESS_KEY_ID=...
# OBJECT_STORAGE_SECRET_ACCESS_KEY=...
# OBJECT_STORAGE_S3_FORCE_PATH_STYLE=true
